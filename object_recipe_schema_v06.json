{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hexsphere.object-recipe/0.6",
  "title": "HexSphere Object Recipe 0.6",
  "type": "object",
  "required": ["format", "version", "object"],
  "properties": {
    "format": {"const": "hexsphere.object-recipe"},
    "version": {"const": "0.6"},
    "object": {"$ref": "#/$defs/object"}
  },
  "additionalProperties": false,
  "$defs": {
    "profileDimension": {"type": "integer", "minimum": 1, "maximum": 128},
    "profile": {
      "type": "object",
      "description": "Rows are stored top-to-bottom and columns left-to-right. Columns map to increasing X; row 0 maps to the highest Y cell center, with the profile origin at its lower-left. This defines source 2D coordinates only, not a 3D plane.",
      "required": ["type", "width", "height", "data"],
      "properties": {
        "type": {"const": "raster"},
        "width": {"$ref": "#/$defs/profileDimension"},
        "height": {"$ref": "#/$defs/profileDimension"},
        "data": {
          "type": "array",
          "description": "Flattened row-major occupancy values: 0 is empty and 1 is occupied.",
          "items": {"type": "integer", "enum": [0, 1]},
          "minItems": 1,
          "maxItems": 16384
        }
      },
      "additionalProperties": false
    },
    "stackLayerCount": {
      "type": "integer",
      "minimum": 2,
      "maximum": 128,
      "description": "Number of fixed profile cross-sections. The first is at Z=0 and the last is at the requested depth, with equal spacing between them."
    },
    "stackDepth": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1000,
      "description": "Total local-space distance along +Z from the first to final cross-section."
    },
    "cellSizeDimension": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100,
      "description": "Positive construction-space width or height of one raster cell."
    },
    "cellSize": {
      "type": "array",
      "items": {"$ref": "#/$defs/cellSizeDimension"},
      "minItems": 2,
      "maxItems": 2
    },
    "evolutionShiftValue": {
      "type": "array",
      "items": {"type": "number", "minimum": -10000, "maximum": 10000},
      "minItems": 2,
      "maxItems": 2
    },
    "evolutionRotationValue": {"type": "number", "minimum": -3600, "maximum": 3600},
    "evolutionScaleValue": {
      "type": "array",
      "items": {"type": "number", "minimum": 0.01, "maximum": 10},
      "minItems": 2,
      "maxItems": 2
    },
    "evolutionShift": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/evolutionShiftValue"},
        "end": {"$ref": "#/$defs/evolutionShiftValue"}
      },
      "additionalProperties": false
    },
    "evolutionRotation": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/evolutionRotationValue"},
        "end": {"$ref": "#/$defs/evolutionRotationValue"}
      },
      "additionalProperties": false
    },
    "evolutionScale": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/evolutionScaleValue"},
        "end": {"$ref": "#/$defs/evolutionScaleValue"}
      },
      "additionalProperties": false
    },
    "evolution": {
      "type": "object",
      "description": "Optional layer evolution relative to the original profile, never cumulatively from the preceding layer. Each supplied operation is interpolated from start to end using t=layer_index/(layer_count-1); values outside the bounded ranges are rejected, not clamped. Missing operations are identity. Apply scale, then rotation, then shift. Rotation and scale use the scaled full-canvas center; shift is local construction-plane XY. Angles interpolate numerically without wraparound. Scale components must remain positive. Mesh ordering is deterministic: layers in increasing Z, vertices by sorted grid-corner/fan key, caps by sorted occupied cell, then side walls by sorted cell and fixed bottom/right/top/left edge order.",
      "required": ["model", "interpolation"],
      "properties": {
        "model": {"const": "original_profile"},
        "interpolation": {"const": "linear"},
        "shift": {"$ref": "#/$defs/evolutionShift"},
        "rotation_degrees": {"$ref": "#/$defs/evolutionRotation"},
        "scale": {"$ref": "#/$defs/evolutionScale"}
      },
      "additionalProperties": false
    },
    "stackConstructionPlane": {
      "enum": ["xy", "yz", "zx"],
      "description": "Right-handed cyclic basis for the raster plane and stack axis: XY=(X,Y), stack +Z; YZ=(Y,Z), stack +X; ZX=(Z,X), stack +Y. Omission means XY."
    },
    "rasterStackGeometry": {
      "type": "object",
      "description": "Creates a capped extrusion in the selected right-handed construction plane. Raster X/Y map to the plane's ordered U/V basis; layers stack along its positive normal. Omitted construction_plane means XY. Optional evolution transforms each layer relative to the original profile. The ordinary part transform is applied after construction.",
      "required": ["type", "profile", "layer_count", "depth"],
      "properties": {
        "type": {"const": "raster_stack"},
        "profile": {"const": "object.profile"},
        "layer_count": {"$ref": "#/$defs/stackLayerCount"},
        "depth": {"$ref": "#/$defs/stackDepth"},
        "cell_size": {"$ref": "#/$defs/cellSize"},
        "construction_plane": {"$ref": "#/$defs/stackConstructionPlane"},
        "evolution": {"$ref": "#/$defs/evolution"}
      },
      "additionalProperties": false
    },
    "constructionCoordinate": {"type": "number", "minimum": -1000000, "maximum": 1000000},
    "point2": {
      "type": "array",
      "items": {"$ref": "#/$defs/constructionCoordinate"},
      "minItems": 2,
      "maxItems": 2
    },
    "axisDirection2": {
      "type": "array",
      "items": {"type": "number", "minimum": -1, "maximum": 1},
      "minItems": 2,
      "maxItems": 2
    },
    "revolutionAxis": {
      "type": "object",
      "required": ["origin", "direction"],
      "properties": {
        "origin": {"$ref": "#/$defs/point2"},
        "direction": {"$ref": "#/$defs/axisDirection2"}
      },
      "additionalProperties": false
    },
    "constructionPlane": {"enum": ["xy", "xz", "yz"]},
    "angularSegments": {"type": "integer", "minimum": 3, "maximum": 256},
    "rasterClipping": {
      "type": "object",
      "description": "Grid-aligned vertical clipping axis. Left retains columns strictly less than axis_column; right retains columns greater than or equal to axis_column. Omit clipping for the full raster.",
      "required": ["side", "axis_column"],
      "properties": {
        "side": {"enum": ["left", "right"]},
        "axis_column": {"type": "integer", "minimum": 0, "maximum": 128}
      },
      "additionalProperties": false
    },
    "rasterRevolutionGeometry": {
      "type": "object",
      "description": "Revolve the clipped filled raster boundary by angular_segments around the explicit 2D axis in the selected construction plane. Raster X/Y map to XY, XZ, or YZ; each swept point rotates from its in-plane radial direction toward the plane normal. Normalize axis direction. The axis may touch the profile boundary but may not cross occupied interior. Sample angles cover [0, 2*pi) without a duplicate seam ring; the final segment connects back to the first. Vertices on the axis are collapsed and axis-aligned boundary edges are omitted.",
      "required": ["type", "construction_plane", "angular_segments", "axis"],
      "properties": {
        "type": {"const": "raster_revolution"},
        "construction_plane": {"$ref": "#/$defs/constructionPlane"},
        "angular_segments": {"$ref": "#/$defs/angularSegments"},
        "axis": {"$ref": "#/$defs/revolutionAxis"},
        "cell_size": {"$ref": "#/$defs/cellSize"},
        "profile_offset": {"$ref": "#/$defs/point2"},
        "clipping": {"$ref": "#/$defs/rasterClipping"}
      },
      "additionalProperties": false
    },
    "rasterTorusGeometry": {
      "type": "object",
      "description": "Revolve the clipped filled raster boundary without layer evolution. axis_mode clip_axis revolves around the vertical clipping axis; offset_from_profile places a parallel vertical axis at axis_offset from the selected profile bound.",
      "required": ["type", "construction_plane", "angular_segments", "axis_mode"],
      "properties": {
        "type": {"const": "raster_torus"},
        "construction_plane": {"$ref": "#/$defs/constructionPlane"},
        "angular_segments": {"$ref": "#/$defs/angularSegments"},
        "cell_size": {"$ref": "#/$defs/cellSize"},
        "profile_offset": {"$ref": "#/$defs/point2"},
        "clipping": {"$ref": "#/$defs/rasterClipping"},
        "axis_mode": {"enum": ["clip_axis", "offset_from_profile"]},
        "axis_side": {"enum": ["left", "right"]},
        "axis_offset": {"type": "number", "minimum": 0.01, "maximum": 10000}
      },
      "allOf": [
        {
          "if": {"properties": {"axis_mode": {"const": "clip_axis"}}},
          "then": {"required": ["clipping"], "not": {"anyOf": [{"required": ["axis_side"]}, {"required": ["axis_offset"]}]}}
        },
        {
          "if": {"properties": {"axis_mode": {"const": "offset_from_profile"}}},
          "then": {"required": ["axis_side", "axis_offset"]}
        }
      ],
      "additionalProperties": false
    },
    "number": {"type": "number", "minimum": -1000000, "maximum": 1000000},
    "value": {
      "anyOf": [
        {"type": "string"},
        {"type": "boolean"},
        {"$ref": "#/$defs/number"},
        {"$ref": "#/$defs/ref"},
        {"$ref": "#/$defs/expression"}
      ]
    },
    "ref": {
      "type": "object",
      "required": ["$ref"],
      "properties": {"$ref": {"type": "string", "minLength": 1, "maxLength": 256}},
      "additionalProperties": false
    },
    "expression": {
      "type": "object",
      "required": ["$expr"],
      "properties": {
        "$expr": {
          "type": "object",
          "required": ["op", "args"],
          "properties": {
            "op": {"enum": ["add", "sub", "mul", "div", "min", "max", "clamp"]},
            "args": {"type": "array", "minItems": 1, "maxItems": 8}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "vector3": {"type": "array", "items": {"$ref": "#/$defs/value"}, "minItems": 3, "maxItems": 3},
    "transform": {
      "type": "object",
      "properties": {
        "position": {"$ref": "#/$defs/vector3"},
        "rotation": {"$ref": "#/$defs/vector3"},
        "scale": {"$ref": "#/$defs/vector3"}
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": ["name", "parent", "local_position"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "maxLength": 80},
        "parent": {"type": "string", "maxLength": 512},
        "local_position": {"$ref": "#/$defs/vector3"},
        "local_rotation": {"$ref": "#/$defs/vector3"},
        "inherit_orientation": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "required": ["id", "type", "parameters"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "maxLength": 160},
        "type": {"type": "string", "minLength": 1, "maxLength": 80},
        "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "transform": {"$ref": "#/$defs/transform"},
        "anchors": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/anchor"}}
      },
      "additionalProperties": false
    },
    "stackPart": {
      "type": "object",
      "required": ["id", "geometry"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "maxLength": 160},
        "geometry": {"$ref": "#/$defs/rasterStackGeometry"},
        "transform": {"$ref": "#/$defs/transform"},
        "anchors": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/anchor"}}
      },
      "additionalProperties": false
    },
    "revolutionPart": {
      "type": "object",
      "required": ["id", "geometry"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "maxLength": 160},
        "geometry": {"$ref": "#/$defs/rasterRevolutionGeometry"},
        "transform": {"$ref": "#/$defs/transform"},
        "anchors": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/anchor"}}
      },
      "additionalProperties": false
    },
    "torusPart": {
      "type": "object",
      "required": ["id", "geometry"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "maxLength": 160},
        "geometry": {"$ref": "#/$defs/rasterTorusGeometry"},
        "transform": {"$ref": "#/$defs/transform"},
        "anchors": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/anchor"}}
      },
      "additionalProperties": false
    },
    "recipePart": {
      "oneOf": [
        {"$ref": "#/$defs/part"},
        {"$ref": "#/$defs/stackPart"},
        {"$ref": "#/$defs/revolutionPart"},
        {"$ref": "#/$defs/torusPart"}
      ]
    },
    "componentPart": {
      "oneOf": [
        {"$ref": "#/$defs/part"},
        {"$ref": "#/$defs/stackPart"}
      ]
    },
    "target": {
      "type": "object",
      "required": ["part", "anchor"],
      "properties": {
        "part": {"type": "string", "maxLength": 160},
        "anchor": {"type": "string", "maxLength": 512}
      },
      "additionalProperties": false
    },
    "connection": {
      "type": "object",
      "required": ["id", "part", "anchor", "target", "mode"],
      "properties": {
        "id": {"type": "string", "maxLength": 160},
        "part": {"type": "string", "maxLength": 160},
        "anchor": {"type": "string", "maxLength": 512},
        "target": {"$ref": "#/$defs/target"},
        "mode": {"enum": ["position", "snap"]},
        "offset": {"$ref": "#/$defs/vector3"},
        "rotation_offset": {"$ref": "#/$defs/vector3"},
        "offset_space": {"enum": ["world", "target"]}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["parameters", "parts", "exposes"],
      "properties": {
        "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "parts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/componentPart"}},
        "connections": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/connection"}},
        "instances": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/instance"}},
        "exposes": {"type": "array", "maxItems": 64, "items": {"type": "object", "required": ["name", "source"], "properties": {"name": {"type": "string", "maxLength": 80}, "source": {"type": "string", "maxLength": 512}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "required": ["id", "component"],
      "properties": {
        "id": {"type": "string", "maxLength": 160},
        "component": {"type": "string", "maxLength": 80},
        "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "transform": {"$ref": "#/$defs/transform"},
        "connection": {"$ref": "#/$defs/instanceConnection"}
      },
      "additionalProperties": false
    },
    "instanceConnection": {
      "type": "object",
      "required": ["anchor", "target"],
      "properties": {
        "anchor": {"type": "string", "maxLength": 80},
        "target": {"$ref": "#/$defs/target"},
        "mode": {"enum": ["position", "snap"]},
        "offset": {"$ref": "#/$defs/vector3"},
        "rotation_offset": {"$ref": "#/$defs/vector3"},
        "offset_space": {"enum": ["world", "target"]}
      },
      "additionalProperties": false
    },
    "replication": {
      "type": "object",
      "required": ["id", "component", "count", "pattern"],
      "properties": {
        "id": {"type": "string", "maxLength": 160},
        "component": {"type": "string", "maxLength": 80},
        "count": {"type": "integer", "minimum": 1, "maximum": 64},
        "pattern": {"enum": ["linear", "radial"]},
        "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "step": {"$ref": "#/$defs/vector3"},
        "center": {"$ref": "#/$defs/vector3"},
        "radius": {"$ref": "#/$defs/value"},
        "start_angle": {"$ref": "#/$defs/value"},
        "angle_step": {"$ref": "#/$defs/value"},
        "transform": {"$ref": "#/$defs/transform"}
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": ["name", "parameters", "parts"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "profile": {"$ref": "#/$defs/profile"},
        "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "parts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/recipePart"}},
        "connections": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/connection"}},
        "components": {"type": "object", "maxProperties": 64, "additionalProperties": {"$ref": "#/$defs/component"}},
        "instances": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/instance"}},
        "replications": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/replication"}}
      },
      "allOf": [{
        "if": {"properties": {"parts": {"contains": {"anyOf": [
          {"$ref": "#/$defs/stackPart"},
          {"$ref": "#/$defs/revolutionPart"},
          {"$ref": "#/$defs/torusPart"}
        ]}}}},
        "then": {"required": ["profile"]}
      }],
      "additionalProperties": false
    }
  }
}
